        {
          "name": "Список комментариев события",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Список получен, статус 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const comments = pm.response.json();",
                  "",
                  "pm.test('Вернулся массив из трёх созданных комментариев', function () {",
                  "    pm.expect(comments).to.be.an('array');",
                  "    pm.expect(comments).to.have.lengthOf(3);",
                  "});",
                  "",
                  "pm.test('В списке присутствуют все созданные комментарии', function () {",
                  "    const ids = comments.map((c) => c.id);",
                  "    pm.expect(ids).to.include(pm.collectionVariables.get('commentId'));",
                  "    pm.expect(ids).to.include(pm.collectionVariables.get('secondCommentId'));",
                  "    pm.expect(ids).to.include(pm.collectionVariables.get('thirdCommentId'));",
                  "});",
                  "",
                  "pm.test('Все комментарии относятся к запрошенному событию', function () {",
                  "    comments.forEach((c) => pm.expect(c.eventId).to.equal(pm.collectionVariables.get('eventId')));",
