{
  "info": {
    "name": "Test Explore With Me — комментарии к событиям",
    "description": "Тесты дополнительной функциональности: создание, просмотр, редактирование и удаление комментариев к событиям.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Подготовка данных",
      "item": [
        {
          "name": "Создать пользователя — автора комментариев",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Уникальный суффикс, чтобы прогон не конфликтовал с данными предыдущих запусков",
                  "pm.collectionVariables.set('rnd', Date.now() + '' + Math.floor(Math.random() * 1000));",
                  "",
                  "// Дата события: через 3 дня (сервис требует минимум +2 часа от текущего момента)",
                  "const d = new Date(Date.now() + 3 * 24 * 60 * 60 * 1000);",
                  "const pad = (n) => String(n).padStart(2, '0');",
                  "const eventDate = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) +",
                  "    ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());",
                  "pm.collectionVariables.set('eventDate', eventDate);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Пользователь создан, статус 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const user = pm.response.json();",
                  "pm.expect(user.id, 'В ответе должен быть id пользователя').to.not.be.undefined;",
                  "pm.collectionVariables.set('userId', user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Автор {{rnd}}\",\n    \"email\": \"author{{rnd}}@practicum.ru\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Создать второго пользователя — постороннего",
