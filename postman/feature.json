        {
          "name": "Создать комментарий к опубликованному событию",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Комментарий создан, статус 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const comment = pm.response.json();",
                  "",
                  "pm.test('Комментарий сохранён в базе — в ответе есть присвоенный id', function () {",
                  "    pm.expect(comment.id, 'id не должен быть пустым: без сохранения в БД он останется null')",
                  "        .to.be.a('number');",
                  "});",
                  "",
                  "pm.test('Поля комментария заполнены корректно', function () {",
                  "    pm.expect(comment.text).to.equal('Отличное событие, обязательно приду');",
                  "    pm.expect(comment.eventId).to.equal(pm.collectionVariables.get('eventId'));",
                  "    pm.expect(comment.userId).to.equal(pm.collectionVariables.get('userId'));",
                  "});",
                  "",
                  "pm.test('Дата создания заполнена в формате yyyy-MM-dd HH:mm:ss', function () {",
                  "    pm.expect(comment.created).to.match(/^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$/);",
                  "});",
                  "",
                  "pm.test('У нового комментария нет даты изменения', function () {",
                  "    pm.expect(comment.updated).to.be.null;",
                  "});",
                  "",
                  "pm.collectionVariables.set('commentId', comment.id);"
                ]
              }
            }
